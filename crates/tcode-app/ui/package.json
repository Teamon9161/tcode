{
  "name": "tcode-ui",
  "private": true,
  "version": "0.1.27",
  "type": "module",
  "scripts": {
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "dev": "node scripts/build-sandbox.mjs && vite",
