{
  "name": "tcode-ui",
  "private": true,
  "version": "0.1.22",
  "type": "module",
  "scripts": {
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "dev": "npm run build:sandbox && vite",
    "build": "npm run build:sandbox && tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:ui": "npm run build:sandbox && PREVIEW=1 vite --open=/preview.html",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "echarts": "^6.1.0",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7",
    "vite": "^7",
    "vitest": "^4.1.10"
  }
}
